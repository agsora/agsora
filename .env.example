# Copy to .env.local (never commit real values).

# Supabase: blog view counts and contact-form leads (server only).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Leave empty to disable.
NEXT_PUBLIC_GA_ID=

# Google Search Console verification token (optional).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Email notification for new leads via Resend (optional).
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
# Sender; must be a domain verified in Resend. Defaults to Resend's test sender.
LEAD_FROM_EMAIL=

# Password for the lead inbox at dashboard.agsora.tech (/admin/leads in dev). Leave empty to disable the admin area.
ADMIN_PASSWORD=

# Meta Ads (dashboard Analisa Iklan). System-user token with ads_read, and the ad account id.
META_ADS_TOKEN=
META_AD_ACCOUNT_ID=
# Protects the cron endpoints (/api/indexnow, /api/ads/sync); Vercel sends it as a Bearer token.
CRON_SECRET=

# Google Drive for job application documents (optional; without it files go to Supabase Storage)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GDRIVE_FOLDER_ID=
