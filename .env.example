# Copy to .env.local (never commit real values).

# Supabase: blog view counts and contact-form leads (server only).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX. Leave empty to disable.
NEXT_PUBLIC_GA_ID=

# Google Search Console verification token (optional).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Email notification for new leads via Resend (optional).
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
# Sender; must be a domain verified in Resend. Defaults to Resend's test sender.
LEAD_FROM_EMAIL=
